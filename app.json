{
  "expo": {
    "name": "PitchMe",
    "slug": "pitchme",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "PitchMe uses your microphone to analyze interview answers."
        }
      ],
      "expo-asset"
    ],
    "android": {
      "package": "com.kshethra.pitchme",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0D14"
      },
      "permissions": ["RECORD_AUDIO"]
    },
    "ios": {
      "bundleIdentifier": "com.kshethra.pitchme",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "PitchMe uses your microphone to record practice interview answers."
      }
    }
  }
}
